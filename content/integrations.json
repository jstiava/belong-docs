        "style": "unordered",
        "meta": {},
        "items": [
          {
            "content": "Authorization returns an <b>access_token</b> and<b> refresh_token</b>, and hopefully notice of when each expire.",
            "meta": {},
            "items": []
          },
          {
            "content": "When the access_token expires, the refresh token is used to get a new one. When the refresh token expires, a new access token cannot be requested.",
            "meta": {},
            "items": []
          },
          {
            "content": "Refresh tokens CANNOT expire. ",
            "meta": {},
            "items": []
          }
        ]
      }
