      "type": "code",
      "data": {
        "code": " try {\n            const res = await GOOGLE_API.post(\"/oauth2/v3/token\", {\n                grant_type: 'authorization_code',\n                code: authorization_code,\n                redirect_uri: `http://localhost:3000/api/v1/auth/callback`\n            });\n\n            console.log(res.data);\n\n            return {\n                ...res.data,\n                access_token_expires: dayjs().add(res.data.expires_in, 's').toDate(),\n                refresh_token_expires: dayjs().add(res.data.refresh_token_expires_in, 's').toDate(),\n            };\n        }\n        catch (err: any) {\n            console.log({\n                message: \"Could not authorize connection\",\n                err,\n                res: err.response\n            });\n            return null;\n        }"
      }
